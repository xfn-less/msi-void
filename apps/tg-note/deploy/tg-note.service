[Unit]
Description=Telegram plaintext file notes
After=network.target

[Service]
Type=simple
User=xfn
Group=xfn
WorkingDirectory=/home/xfn/work
EnvironmentFile=/home/xfn/.config/tg-note/env
ExecStart=/home/xfn/work/tg-note
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/xfn/memo

[Install]
WantedBy=multi-user.target
