*.swp
*~
.DS_Store
.worktrees/

# Local state and private material never belong in the public config tree.
Documents/
**/.cache/
**/.tmp/
**/test-results/
**/.bash_history
**/.lesshst
**/.config/htop/htop_history
**/accounts.json
**/pppuser.csv

# Build state; tri's own .gitignore keeps only its portable final binary.
**/.zig-cache/
**/zig-pkg/
**/.tri-build.*
**/zig-out/bin/tri.previous

# Python bytecode generated by local checks.
__pycache__/
*.py[cod]

# Editor recovery files can be created alongside any edited config.
\#*\#
.\#*
*.swo

# 配置白名单：目录允许遍历，文件默认不纳入；只放行下面的配置和源码目录。
/root/home/.config/**
!/root/home/.config/**/
!/root/home/.config/alacritty/**
!/root/home/.config/fcitx5/config
!/root/home/.config/fcitx5/profile
!/root/home/.config/fcitx5/conf/classicui.conf
!/root/home/.config/fcitx5/conf/clipboard.conf
!/root/home/.config/fcitx5/conf/pinyin.conf
!/root/home/.config/fontconfig/**
!/root/home/.config/htop/htoprc
!/root/home/.config/mimeapps.list
!/root/home/.config/mimeapps.list.example
!/root/home/.config/niri/**

/root/home/.local/share/**
!/root/home/.local/share/**/
!/root/home/.local/share/applications/vim.desktop

# 放行的源码目录也不收编译产物和编辑器临时文件。
.DS_Store
**/.cache/
**/accounts.json
**/pppuser.csv
__pycache__/
*.py[cod]
*.elc
*.eln
*.swp
*.swo
*~
\#*\#
.\#*
