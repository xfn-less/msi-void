#!/usr/bin/env bash
set -euo pipefail

usage() {
	cat <<'EOF'
用法：xb <a|g|k|o|r|s> [关键词]

  a  删除所有已安装包
  g  更新系统
  k  清理旧内核
  o  删除孤儿包
  r  删除手动安装且不在 packages.list 的包
  s  搜索并安装包
EOF
}

remove_packages() {
	local title=$1 query=${2:-}
	cat |
		sort -u |
		awk '{print $0 "\t" $0}' |
		fzf -q "$query" --multi --delimiter=$'\t' --with-nth=1 \
			--header="$title；Tab 多选后删除" --preview 'xbps-query {2}' |
		awk -F '\t' '{print $2}' | xargs -r -o sudo xbps-remove -R
}

all_packages() {
	local query=${*:-}
	xbps-query -l | awk '$1 == "ii" { name=$2; sub(/-[0-9].*/, "", name); print name }' |
		remove_packages '所有已安装包' "$query"
}

orphan_packages() {
	xbps-query -O | sed 's/-[0-9].*//' |
		sort -u | awk '{print $0 "\t" $0}' |
		fzf --multi --bind='ctrl-a:toggle-all' --delimiter=$'\t' --with-nth=1 \
			--header='孤儿包；Tab 多选，Ctrl-A 全选/取消' \
			--preview-window='right,60%,wrap' --preview 'xbps-query {2}' |
		awk -F '\t' '{print $2}' | xargs -r -o sudo xbps-remove -R
}

manual_packages() {
	local script repo manual
	script=$(readlink -f -- "${BASH_SOURCE[0]}")
	repo=$(cd -- "$(dirname -- "$script")/../../../.." && pwd)
	manual=$(xbps-query -m | sed 's/-[^-]*$//')

	printf '%s\n' "$manual" |
		awk -F'|' '
			FILENAME == "-" {if ($0 != "") {installed[$0]=1; order[++count]=$0} next}
			{
				n=split($2, names, " ")
				for(i=1;i<=n;i++) if((names[i] in installed) && !(names[i] in listed)) {
					printf "[%s] %s\t%s\n", $1, names[i], names[i]
					listed[names[i]]=1
				}
			}
			END {
				for(i=1;i<=count;i++) if(!(order[i] in listed))
					printf "%s\t%s\n", order[i], order[i]
			}' - "$repo/packages.list" |
		fzf --multi --no-sort --delimiter=$'\t' --with-nth=1 \
			--preview-window='right,60%,wrap' --preview 'xbps-query {2}' |
		awk -F '\t' '{print $2}' | sort -u | xargs -r -o sudo xbps-remove -R
}

update_system() {
	sudo xbps-install -Syu
}

clean_kernel() {
	local versions
	versions=$(vkpurge list | sort -V | head -n -1)
	if [[ -z $versions ]]; then
		printf '%s\n' '没有需要清理的旧内核。'
		return
	fi
	printf '%s\n' "$versions" | xargs -r -o -n 1 sudo vkpurge rm
}

search_packages() {
	local empty_conf query selected fzf_status
	empty_conf=$(mktemp -d)
	trap 'rm -rf "$empty_conf"' RETURN

	xb_repos() {
		xbps-query -L 2>/dev/null | awk '
		$2 ~ /^https?:\/\// {
			url = $2; tag = "main"
			if (url ~ /\/multilib\/nonfree\/?$/) tag = "ml-nf"
			else if (url ~ /\/nonfree\/?$/) tag = "nonfree"
			else if (url ~ /\/multilib\/?$/) tag = "multilib"
			else if (url ~ /\/debug\/?$/) tag = "debug"
			else { n = split(url, a, "/"); last = a[n]; if (last != "" && last != "current" && last != "musl") tag = last }
			print tag "\t" url
		}'
	}

	xb_list_repo() {
		local tag=$1 url=$2 q=$3
		xbps-query -C "$empty_conf" -i --repository="$url" -Rs "$q" | awk -v tag="$tag" '
		$1 ~ /^\[/ {
			ver=$2; name=ver
			if (match(ver, /-[0-9]/)) name=substr(ver, 1, RSTART-1)
			else if (match(ver, /-r[0-9]/)) name=substr(ver, 1, RSTART-1)
			mark=($1 == "[*]") ? "*" : " "
			printf "%s %-7s %s\t%s\n", mark, tag, name, name
		}'
	}

	query=${*:-}
	mapfile -t repos < <(xb_repos)
	((${#repos[@]} > 0)) || { echo 'xb s: 未找到已启用的 xbps 仓库' >&2; return 1; }
	set +e
	selected=$(
		for entry in "${repos[@]}"; do
			IFS=$'\t' read -r tag url <<<"$entry"
			xb_list_repo "$tag" "$url" "$query"
		done | sort -u -t $'\t' -k2,2 |
		fzf -q "$query" --multi --delimiter=$'\t' --with-nth=1 \
			--header='左边: repo 包名  (*已装)   Tab多选 Enter安装 Esc取消' \
			--preview-window='right,55%,wrap,border-left' --preview 'xbps-query -R {2}'
	)
	fzf_status=$?
	set -e
	[[ $fzf_status -eq 0 && -n ${selected:-} ]] || return 0
	mapfile -t pkgs < <(printf '%s\n' "$selected" | awk -F '\t' 'NF >= 2 {print $2}')
	((${#pkgs[@]} > 0)) && sudo xbps-install -S "${pkgs[@]}"
}

case ${1:-} in
a) shift; all_packages "$@" ;;
g) update_system ;;
k) clean_kernel ;;
o) shift; orphan_packages "$@" ;;
r) shift; manual_packages "$@" ;;
s) shift; search_packages "$@" ;;
*) usage; exit 2 ;;
esac
