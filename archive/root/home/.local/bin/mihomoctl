#!/bin/sh
# Thin command-line interface to Mihomo's native controller API.
set -eu

API=${MIHOMO_API:-http://127.0.0.1:9090}
CURL=${CURL:-curl}
SV=${SV:-sv}
SUDO=${SUDO:-sudo}
MIHOMO=${MIHOMO:-/usr/local/bin/mihomo}
MIHOMO_LOG=${MIHOMO_LOG:-/var/log/sv/mihomo/current}

usage() {
	cat >&2 <<'EOF'
usage:
  mihomoctl status
  mihomoctl use rule split
  mihomoctl use global hk|cn|EXACT_NODE_NAME
  mihomoctl use direct
  mihomoctl nodes
  mihomoctl update
  mihomoctl adblock on|off|status
  mihomoctl check
  mihomoctl log
EOF
}

api_get() {
	"$CURL" --fail --silent --show-error --connect-timeout 3 "$API$1"
}

api_write() {
	method=$1 path=$2 data=${3:-}
	if [ -n "$data" ]; then
		"$CURL" --fail --silent --show-error --connect-timeout 3 \
			--request "$method" --header 'Content-Type: application/json' \
			--data "$data" "$API$path"
	else
		"$CURL" --fail --silent --show-error --connect-timeout 3 \
			--request "$method" "$API$path"
	fi
}

json_name() {
	python3 -c 'import json,sys; print(json.dumps({"name": sys.argv[1]}, ensure_ascii=False))' "$1"
}

set_mode() {
	api_write PATCH /configs "{\"mode\":\"$1\"}" >/dev/null
}

select_global() {
	name=$1
	current=$(api_get /proxies/GLOBAL)
	if ! printf '%s' "$current" | python3 -c '
import json, sys
name = sys.argv[1]
data = json.load(sys.stdin)
raise SystemExit(0 if name in data.get("all", []) else 1)
' "$name"; then
		printf '未知节点：%s\n' "$name" >&2
		exit 1
	fi
	api_write PUT /proxies/GLOBAL "$(json_name "$name")" >/dev/null
}

show_group() {
	label=$1 path=$2
	value=$(api_get "$path" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("now", "-"))')
	printf '%-8s %s\n' "$label:" "$value"
}

list_group() {
	api_get "$1" | python3 -c '
import json, sys
for name in json.load(sys.stdin).get("all", []):
    print(name)
'
}

ad_rule() {
	api_get /rules | python3 -c '
import json, sys
for rule in json.load(sys.stdin).get("rules", []):
    if "category-ads-all" in rule.get("payload", "") and rule.get("proxy") == "REJECT":
        disabled = rule.get("extra", {}).get("disabled", False)
        print(rule["index"], str(disabled).lower())
        break
else:
    raise SystemExit("ad blocking rule not found")
'
}

case ${1:-} in
status)
	[ "$#" -eq 1 ] || { usage; exit 2; }
	"$SUDO" "$SV" status mihomo
	mode=$(api_get /configs | python3 -c 'import json,sys; print(json.load(sys.stdin).get("mode", "-"))')
	printf '%-8s %s\n' 'mode:' "$mode"
	show_group 'global' /proxies/GLOBAL
	show_group '香港' /proxies/%E9%A6%99%E6%B8%AF
	show_group '国内' /proxies/%E5%9B%BD%E5%86%85
	;;
use)
	case ${2:-} in
	rule)
		[ "$#" -eq 3 ] && [ "$3" = split ] || { usage; exit 2; }
		set_mode rule
		;;
	global)
		[ "$#" -eq 3 ] || { usage; exit 2; }
		case $3 in
		hk) node=香港 ;;
		cn) node=国内 ;;
		*) node=$3 ;;
		esac
		select_global "$node"
		set_mode global
		;;
	direct)
		[ "$#" -eq 2 ] || { usage; exit 2; }
		set_mode direct
		;;
	*) usage; exit 2 ;;
	esac
	;;
nodes)
	[ "$#" -eq 1 ] || { usage; exit 2; }
	list_group /proxies/%E9%A6%99%E6%B8%AF
	list_group /proxies/%E5%9B%BD%E5%86%85
	;;
update)
	[ "$#" -eq 1 ] || { usage; exit 2; }
	printf '%s\n' '静态节点无需更新；修改 /etc/mihomo/config.yaml 后执行 sudo sv restart mihomo。'
	;;
adblock)
	[ "$#" -eq 2 ] || { usage; exit 2; }
	action=$2
	set -- $(ad_rule)
	index=$1 disabled=$2
	case $action in
	on) api_write PATCH /rules/disable "{\"$index\":false}" >/dev/null ;;
	off) api_write PATCH /rules/disable "{\"$index\":true}" >/dev/null ;;
	status)
		if [ "$disabled" = true ]; then printf '%s\n' off; else printf '%s\n' on; fi
		;;
	*) usage; exit 2 ;;
	esac
	;;
check)
	[ "$#" -eq 1 ] || { usage; exit 2; }
	exec "$SUDO" "$MIHOMO" -t -d /var/lib/mihomo -f /etc/mihomo/config.yaml
	;;
log)
	[ "$#" -eq 1 ] || { usage; exit 2; }
	exec "$SUDO" tail -n 100 "$MIHOMO_LOG"
	;;
*) usage; exit 2 ;;
esac
