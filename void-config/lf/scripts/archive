#!/bin/sh
# Create an archive from lf selections without staging or deleting source paths.
set -eu

kind=${1:-}
output=${2:-}
[ "$#" -ge 3 ] || {
	printf 'usage: lf-archive tar|zip OUTPUT INPUT...\n' >&2
	exit 2
}
shift 2

[ -n "$output" ] || {
	printf 'lf-archive: output name is empty\n' >&2
	exit 2
}
[ ! -e "$output" ] || {
	printf 'lf-archive: output already exists: %s\n' "$output" >&2
	exit 1
}

case $kind in
tar) exec tar -czf "$output" -- "$@" ;;
zip) exec zip -r -- "$output" "$@" ;;
*)
	printf 'lf-archive: unknown format: %s\n' "$kind" >&2
	exit 2
	;;
esac
