#!/bin/sh
set -eu

path=$1
w=${2:-80}
h=${3:-40}

[ -f "$path" ] || [ -L "$path" ] || exit 0
[ -d "$path" ] && exit 0

ext=${path##*.}
ext=$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')
mime=$(file --mime-type -Lb -- "$path" 2>/dev/null) || mime=

case $ext in
7z|bz|bz2|gz|lz|lz4|lzma|rar|tar|tbz|tbz2|tgz|tlz|txz|xz|zst|zip)
	tar -tvf "$path" 2>/dev/null || unzip -l "$path" 2>/dev/null || file -Lb -- "$path"
	exit 0
	;;
pdf)
	if command -v pdftotext >/dev/null 2>&1; then
		pdftotext -l 2 -nopgbrk -q -- "$path" - 2>/dev/null | sed -n "1,${h}p"
	else
		file -Lb -- "$path"
	fi
	exit 0
	;;
esac

case $mime in
text/*|application/json|application/xml|application/javascript|\
application/x-sh|application/x-shellscript|inode/x-empty)
	bat --color=always --style=plain --paging=never --line-range ":$h" -- "$path" 2>/dev/null \
		|| sed -n "1,${h}p" -- "$path"
	;;
image/*)
	chafa -f symbols -s "${w}x${h}" --animate off -- "$path" 2>/dev/null \
		|| file -Lb -- "$path"
	;;
video/*|audio/*)
	mediainfo -- "$path" 2>/dev/null || file -Lb -- "$path"
	;;
application/pdf)
	if command -v pdftotext >/dev/null 2>&1; then
		pdftotext -l 2 -nopgbrk -q -- "$path" - 2>/dev/null | sed -n "1,${h}p"
	else
		file -Lb -- "$path"
	fi
	;;
*) file -Lb -- "$path" ;;
esac
